# Copy to .env and fill in. Never commit .env.
CRUSTDATA_API_KEY=
GEMINI_API_KEY=

# Per-run ceilings (every run stops cleanly when either is hit)
RUN_CREDIT_CEILING=300
RUN_TIME_CEILING_SECONDS=2400

# Optional: put the SQLite ledger somewhere outside a synced folder (OneDrive, Dropbox) to avoid lock issues.
# Leave unset to use ./data/partnerscout.db. With no CRUSTDATA_API_KEY and this unset, the app opens the committed demo snapshot read-only.
# PARTNERSCOUT_DB=/absolute/path/to/partnerscout.db

# Set to 1 to force the read-only demo snapshot (demo_data/demo.db) even when keys are present.
# PARTNERSCOUT_DEMO=1
