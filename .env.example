# Copy to .env and fill in. Never commit .env.
CRUSTDATA_API_KEY=
GEMINI_API_KEY=

# Per-run ceilings (every run stops cleanly when either is hit)
RUN_CREDIT_CEILING=300
RUN_TIME_CEILING_SECONDS=2400

# Keep the SQLite ledger outside OneDrive sync to avoid lock issues
PARTNERSCOUT_DB=C:/Users/Jakki/AppData/Local/partnerscout/partnerscout.db
