<mxfile host="app.diagrams.net"><diagram name="Business architecture" id="business-architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="PartnerScout: business architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#101F2C;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="n3" value="Figures marked (assumption) are our own estimates and have not been tested with a customer." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#62717D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Who it is for" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="400" height="330" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Buyers&lt;/b&gt;&lt;br&gt;Partnership, business development and corporate strategy leads at B2B SaaS and technology companies entering a new industry or country" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="360" height="100" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Secondary buyers&lt;/b&gt;&lt;br&gt;Business development agencies and strategy consultancies serving several such clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="360" height="80" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Job to be done&lt;/b&gt;&lt;br&gt;Find partners worth pursuing, know why, and know what could make a partnership a bad idea" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E9;strokeColor=#C65353;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="355" width="360" height="60" as="geometry"/></mxCell><mxCell id="n8" value="The service it replaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="360" height="330" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Today&lt;/b&gt;&lt;br&gt;An analyst or agency searches directories, reads websites and news, builds a spreadsheet and drafts outreach: days to weeks per shortlist (our estimate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="480" y="140" width="320" height="130" as="geometry"/></mxCell><mxCell id="n10" value="Why a database or a general chatbot is not enough: lead lists say who could be pitched, not who would work for both sides; a chatbot answers from memory, without sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F4EF;strokeColor=#E4E8E5;fontColor=#62717D;fontSize=11;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="480" y="290" width="320" height="125" as="geometry"/></mxCell><mxCell id="n11" value="What PartnerScout delivers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="850" y="100" width="420" height="330" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;One request in, one decision-ready brief out&lt;/b&gt;&lt;br&gt;Ranked partners, quote-checked evidence, competitor and namesake checks, mutual-value analysis, decision-maker from the data record, draft first message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="870" y="140" width="380" height="130" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Differentiators&lt;/b&gt;&lt;br&gt;Mutual value analysis · conflict detection with a manual-review override · evidence confidence separate from fit · resumable runs with a credit ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="870" y="290" width="380" height="125" as="geometry"/></mxCell><mxCell id="n14" value="Where a person stays in charge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1300" y="100" width="370" height="330" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Approves every outreach draft&lt;/b&gt;&lt;br&gt;The app records the decision; it never sends anything" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E0;strokeColor=#D5A85B;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1320" y="140" width="330" height="80" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Confirms vague points&lt;/b&gt;&lt;br&gt;for example the exact product niche, and any company flagged for manual review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E0;strokeColor=#D5A85B;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1320" y="240" width="330" height="80" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Tests real interest&lt;/b&gt;&lt;br&gt;Mutual value is a hypothesis, not proof a partner is willing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E0;strokeColor=#D5A85B;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1320" y="340" width="330" height="75" as="geometry"/></mxCell><mxCell id="e18" value="pays for" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="replaced by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="drafts go to" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="Pricing (assumption)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="520" height="220" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Per brief:&lt;/b&gt; about Rs 4,000 for up to 5 vetted partners&lt;br&gt;&lt;b&gt;Subscription:&lt;/b&gt; about Rs 25,000 a month for 10 briefs&lt;br&gt;&lt;b&gt;Agency use:&lt;/b&gt; volume pricing, to be defined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="510" width="480" height="90" as="geometry"/></mxCell><mxCell id="n23" value="No margin is claimed. Crustdata's price per credit and hosting cost are not known to us, so only credits and model cost are measured." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F4EF;strokeColor=#E4E8E5;fontColor=#62717D;fontSize=11;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="480" height="55" as="geometry"/></mxCell><mxCell id="n24" value="Cost of one brief (measured on a cold-cache run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="580" y="470" width="520" height="220" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Crustdata data:&lt;/b&gt; about 25 credits (run with 6 companies investigated)&lt;br&gt;&lt;b&gt;Model usage:&lt;/b&gt; about US$0.09 to 0.11 at an assumed list price; free tier billed US$0&lt;br&gt;&lt;b&gt;Time:&lt;/b&gt; about 10 minutes, limited by the 5 requests per minute rate limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="600" y="510" width="480" height="100" as="geometry"/></mxCell><mxCell id="n26" value="Every call is in a ledger and reconciles with the account balance to within 0.13 credits (the gap is a manual test call)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F4EF;strokeColor=#E4E8E5;fontColor=#62717D;fontSize=11;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="600" y="625" width="480" height="50" as="geometry"/></mxCell><mxCell id="n27" value="How it reaches customers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1130" y="470" width="540" height="220" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Web app&lt;/b&gt; (Streamlit): brief, live workspace, partner ecosystem map, pipeline, dashboard&lt;br&gt;&lt;b&gt;Deliverable:&lt;/b&gt; self-contained HTML report, printable to PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1150" y="510" width="500" height="90" as="geometry"/></mxCell><mxCell id="n29" value="Sold as episodic research today (new market, product launch, partner review). Retention would need ongoing partner monitoring, which is not built." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F4EF;strokeColor=#E4E8E5;fontColor=#62717D;fontSize=11;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1150" y="615" width="500" height="60" as="geometry"/></mxCell><mxCell id="e30" value="price vs cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;dashed=1;" edge="1" parent="1" source="n22" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="What we would build next, and why not today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1640" height="150" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Partner monitoring&lt;/b&gt;&lt;br&gt;Alerts on executive changes, funding and adverse news. Needs its own approval design; does not improve today's research quality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F4EF;strokeColor=#E4E8E5;fontColor=#62717D;fontSize=11;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="50" y="760" width="380" height="90" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;CRM export&lt;/b&gt;&lt;br&gt;Push approved partners and drafts to a CRM. Needs a customer to define the target system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F4EF;strokeColor=#E4E8E5;fontColor=#62717D;fontSize=11;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="460" y="760" width="380" height="90" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Customer validation&lt;/b&gt;&lt;br&gt;Test price, frequency and the brief format with real partnership teams; the largest open question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F4EF;strokeColor=#E4E8E5;fontColor=#62717D;fontSize=11;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="870" y="760" width="380" height="90" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;Wider coverage and relationships&lt;/b&gt;&lt;br&gt;More data sources and partner-to-partner links; none exists in this build, so the map draws none" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F4EF;strokeColor=#E4E8E5;fontColor=#62717D;fontSize=11;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1280" y="760" width="370" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>