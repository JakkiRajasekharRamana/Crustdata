<mxfile host="app.diagrams.net"><diagram name="Technical architecture" id="technical-architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="PartnerScout: technical architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#101F2C;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="n3" value="One request goes in; a ranked, evidence-backed partnership brief comes out. A person approves every outreach draft; nothing is sent automatically." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#62717D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="24" as="geometry"/></mxCell><mxCell id="n4" value="1  Interface and input checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1640" height="120" as="geometry"/></mxCell><mxCell id="n5" value="Requester&lt;br&gt;(business development or strategy team)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="200" height="60" as="geometry"/></mxCell><mxCell id="n6" value="Streamlit app (app.py)&lt;br&gt;Brief · Workspace · Ecosystem · Pipeline · Dashboard · Brief generator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="330" height="60" as="geometry"/></mxCell><mxCell id="n7" value="Request validation (validation.py)&lt;br&gt;rejects or asks for clarification before any model or paid call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="710" y="140" width="330" height="60" as="geometry"/></mxCell><mxCell id="n8" value="HTML report (report.py)&lt;br&gt;sources, quotes, drafts; print to PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1100" y="140" width="300" height="60" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="2  Staged pipeline (pipeline.py): each stage is checkpointed, so a crashed run resumes without repeating paid calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="1640" height="190" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;1. Understand request&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Gemini turns the text into a brief: partner types, target segment, search queries, what to confirm&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="210" height="130" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;2. Discover&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;3 ranked company searches; duplicates collapsed by domain and normalised name&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="280" y="290" width="210" height="130" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;3. Rank (ranking.py)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Deterministic score from the description and brief; the model gives only categorical judgements at temperature 0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="510" y="290" width="210" height="130" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;4. Investigate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Identity, enrichment, own website, news and adverse media; Person Search only if no decision-maker is listed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="290" width="210" height="130" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;5. Verify (evidence.py)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Each claim needs a verbatim quote found in its source; sources are classified; redirects resolved&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="970" y="290" width="210" height="130" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;6. Evaluate (scoring.py)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;5-part fit score, conflict penalty, relationship dimensions, mutual value; evidence confidence kept separate&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1200" y="290" width="210" height="130" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;7. Recommend&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Ranked brief, partnership model, decision-maker from the API record, draft message&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1430" y="290" width="210" height="130" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="valid request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n7" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n18" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="3  External services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="1640" height="150" as="geometry"/></mxCell><mxCell id="n28" value="Crustdata API&lt;br&gt;/company/search · /company/identify · /company/enrich · /person/search&lt;br&gt;/web/enrich/live (own website) · /web/search/live (news)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="560" height="80" as="geometry"/></mxCell><mxCell id="n29" value="Gemini models (llm.py)&lt;br&gt;rotates across model names on overload; used for brief parsing, categorical screening, claim extraction, assessment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="510" width="520" height="80" as="geometry"/></mxCell><mxCell id="n30" value="Failure policy&lt;br&gt;A failed tool call holds the company for review; it is never read as &quot;no evidence&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E9;strokeColor=#C65353;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1290" y="510" width="340" height="80" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;dashed=1;" edge="1" parent="1" source="n13" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;dashed=1;" edge="1" parent="1" source="n15" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;dashed=1;" edge="1" parent="1" source="n12" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;dashed=1;" edge="1" parent="1" source="n14" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;dashed=1;" edge="1" parent="1" source="n16" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;dashed=1;" edge="1" parent="1" source="n17" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="4  Shared services and state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E4E8E5;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#62717D;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="1640" height="190" as="geometry"/></mxCell><mxCell id="n38" value="Central Crustdata client (crustdata.py)&lt;br&gt;per-endpoint rate limits read from /account/endpoints · retries bounded · honours x-ratelimit-reset · 402 stops the run · credit and time ceilings checked before every call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2EE;strokeColor=#167C68;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="560" height="120" as="geometry"/></mxCell><mxCell id="n39" value="SQLite (store.py)&lt;br&gt;call ledger (credits per call) · response cache · stage checkpoints · evidence ledger · approvals · pipeline stages" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F5F4EF;strokeColor=#101F2C;fontColor=#101F2C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="690" width="420" height="120" as="geometry"/></mxCell><mxCell id="n40" value="Human approval gate&lt;br&gt;A person reviews each draft. Approving records the decision only; there is no send step." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E0;strokeColor=#D5A85B;fontColor=#101F2C;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1190" y="690" width="440" height="120" as="geometry"/></mxCell><mxCell id="e41" value="all calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;dashed=1;" edge="1" parent="1" source="n28" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e42" value="ledger + cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n38" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e43" value="evidence rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;dashed=1;" edge="1" parent="1" source="n16" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e44" value="drafts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n8" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e45" value="approvals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#101F2C;fontSize=10;fontColor=#62717D;" edge="1" parent="1" source="n40" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n46" value="Where each fact comes from: Crustdata record fields (company identity, headcount, people), the company's own site (labelled self-reported), and news or directory results (classified by source type). A statement with no matching quote is shown as &quot;I can't verify this from the available sources&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F4EF;strokeColor=#E4E8E5;fontColor=#62717D;fontSize=11;arcSize=8;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="1570" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>